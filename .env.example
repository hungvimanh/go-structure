APP_PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=disable

I18N_DIR=internal

# So giay toi da cho 1 request xu ly truoc khi bi cancel context (tra 504).
# Muc dich: tranh 1 query treo giu connection trong pgxpool vo thoi han khi
# traffic cao (pool chi co gioi han connection, xem posgres.go).
REQUEST_TIMEOUT_SECONDS=10

# 1 = tra ve chi tiet loi technical (500/apperror) day du trong response.
# 0 (mac dinh) = che message chung chung nhu production. KHONG bat o production.
DEV_MODE=0

# RSA key pair dung de ky/verify access token (RS256).
# Dan gia tri PEM tren 1 dong, xuong dong bang \n, bao trong dau ngoac kep
# de godotenv tu chuyen \n thanh newline that khi load.
# Vi du:
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----\n"
JWT_PUBLIC_KEY=
# Chua duoc dung o dau (chua co feature issue token), giu cho chuc nang sau.
JWT_PRIVATE_KEY=
